  "components": {
    "schemas": {
      "AcceptDraftsRequest": {
        "required": [
          "drafts"
        ],
        "type": "object",
        "properties": {
          "drafts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CreateQuestionRequest"
            }
          }
        }
      },
      "AcceptDraftsResponse": {
        "required": [
          "accepted",
          "rejected"
        ],
        "type": "object",
        "properties": {
          "accepted": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionResponse"
            }
          },
          "rejected": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RejectedDraft"
            }
          }
        }
      },
      "AiStatusResponse": {
        "required": [
          "enabled",
          "usedToday",
          "dailyCap"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "usedToday": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "dailyCap": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "AnswerAttemptResponse": {
        "required": [
          "id",
          "questionId",
          "answer",
          "verdict",
          "score",
          "covered",
          "missing",
          "feedback",
          "createdAt",
          "suggestedRating"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "questionId": {
            "type": "string",
            "format": "uuid"
          },
          "answer": {
            "type": "string"
          },
