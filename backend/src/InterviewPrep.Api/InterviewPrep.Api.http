@host = http://localhost:5080

GET {{host}}/api/health

###
GET {{host}}/api/topics

###
GET {{host}}/api/questions?topic=CSharp&difficulty=Middle&tag=async

###
POST {{host}}/api/questions
Content-Type: application/json

{
  "topic": "CSharp",
  "text": "What is boxing?",
  "answer": "Converting a value type to object (or an interface), which allocates on the heap.",
  "difficulty": "Junior",
  "tags": ["types", "memory"]
}

### Study: counts per topic for the setup screen (tz = the browser's IANA time zone)
GET {{host}}/api/study/summary?tz=Europe/Kyiv

###
GET {{host}}/api/study/queue?topic=Sql&topic=CSharp&limit=20&tz=Europe/Kyiv

###
# Take a questionId from the queue. reviewId is generated by the client; repeating it is harmless.
POST {{host}}/api/study/reviews
Content-Type: application/json

{
  "questionId": "00000000-0000-0000-0000-000000000000",
  "rating": "Good",
  "reviewId": "11111111-1111-1111-1111-111111111111"
}

###
# Undo (only the card's latest review)
DELETE {{host}}/api/study/reviews/11111111-1111-1111-1111-111111111111

###
POST {{host}}/api/study/cards/00000000-0000-0000-0000-000000000000/suspend
